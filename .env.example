# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Telegram bot for the Chief Execution Officer's alerts (Phase 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used for AI-generated agent summaries (Phase 2+)
ANTHROPIC_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with real contact info, e.g.
# "AI CFO Platform yourname@example.com" — see connectors/sec_edgar_connector.py
SEC_USER_AGENT=

# Free key from https://www.eia.gov/opendata/register.php — used by
# connectors/eia_connector.py for Commodity Fundamentals (energy inventory/
# storage data). Optional; without it, energy commodity fundamentals
# degrade to a "missing" data gap, same as any other unconfigured source.
EIA_API_KEY=

# Public market-news RSS feed for the Chief Sentiment Officer. Leave blank
# to use the default (MarketWatch top stories, free, no key).
NEWS_RSS_URL=

# Minimum quality score (0-100) required before any dataset is considered usable
MIN_DATA_QUALITY=60

LOG_LEVEL=INFO

# Show Commercial (hedger) COT positioning as INFORMATIONAL context on the
# Chief Commodity/FX Analyst reports. Defaults to false. Even when true,
# Commercial data NEVER affects bias/confidence/overall market score — see
# docs/ARCHITECTURE_COMMERCIAL_REMOVAL_FROM_COT.md.
ENABLE_COMMERCIAL_POSITIONING_DISPLAY=false

# Alpaca broker credentials (execution layer — brokers/alpaca_connector.py).
# SAFETY: there is deliberately NO "live trading" flag here or anywhere in
# .env. AlpacaConnector always defaults to PAPER trading regardless of what's
# in this file — enabling live trading requires live_trading_confirmed=True
# passed explicitly in Python code, every time. See
# docs/ARCHITECTURE_EXECUTION_LAYER.md before using these for anything.
ALPACA_API_KEY=
ALPACA_API_SECRET=
